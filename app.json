{
  "expo": {
    "name": "Couteau",
    "slug": "Couteau",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/fotoisaac.png",
    "scheme": "couteau",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/fotoisaac.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/fotoisaac.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/fotoisaac.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "1d2f2164-b5ce-4dc4-a4d8-300d803acad7"
      }
    },
    "owner": "isak1956x"
  }
}
